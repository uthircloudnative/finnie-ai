# Finnie AI - Environment Variables
# Copy this file to .env and replace the placeholder values

# -------------------------------------------------------------------
# Embeddings Provider (controls which AI model generates vectors)
# Options: "openai" | "azure_openai" | "huggingface" | "fake"
# Default: "openai"
# -------------------------------------------------------------------
EMBEDDING_PROVIDER="openai"

# OpenAI (used when EMBEDDING_PROVIDER=openai)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="dummy_key_for_testing"

# Azure OpenAI (used when EMBEDDING_PROVIDER=azure_openai)
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT=""
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-ada-002"

# HuggingFace (used when EMBEDDING_PROVIDER=huggingface — runs locally, no API cost!)
# HF_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"

# -------------------------------------------------------------------
# Chroma Vector Database
# Leave CHROMA_API_KEY empty to use local on-disk ChromaDB (development)
# Set all three to connect to Chroma Cloud (staging/production)
# -------------------------------------------------------------------
CHROMA_API_KEY=""
CHROMA_TENANT="593f59c6-1467-4da4-9b5d-e58042e3976d"
CHROMA_DATABASE="finnie-ai-db"

# -------------------------------------------------------------------
# Azure Deployment Settings
# (Leave defaults for local dev — only set these in Azure App Service)
# -------------------------------------------------------------------

# CORS: comma-separated list of allowed frontend origins
# Local default covers the Vite dev server automatically.
# Azure: set to your Static Web App or custom domain URL.
# ALLOWED_ORIGINS="https://finnie-ai.azurestaticapps.net,https://www.finnie.app"

# SQLite path — use /home for persistent Azure App Service storage
# DB_PATH="/home/finnie.db"

# Gunicorn worker count (default 2). Increase on higher Azure tiers.
# WORKERS=2

# -------------------------------------------------------------------
# Mailgun Email Notification Engine (Optional)
# Leave empty for local development (defaults to console fallback).
# Set these to enable real transactional email delivery for OTPs.
# -------------------------------------------------------------------
# MAILGUN_API_KEY="key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# MAILGUN_DOMAIN="sandboxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.mailgun.org"
# MAILGUN_BASE_URL="https://api.mailgun.net"
# MAILGUN_FROM_EMAIL="Finnie AI Security <postmaster@sandboxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.mailgun.org>"

